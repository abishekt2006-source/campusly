# ==============================================================================
# CAMPUSLY FRONTEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# FastAPI Backend URL (Local dev: http://127.0.0.1:8000/api/v1, Prod: your Vercel backend URL)
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"

# Supabase Client Credentials
# Safe for frontend - only use the ANON Public Key here! NEVER the service_role key!
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# College branding configuration
VITE_COLLEGE_NAME="Apex University"
VITE_COLLEGE_DOMAIN="college.edu"
