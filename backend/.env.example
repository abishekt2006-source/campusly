# ==============================================================================
# CAMPUSLY BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="Campusly API"
API_V1_PREFIX="/api/v1"
DEBUG=True

# College Email Domain Restriction (Only students with this domain can register)
# Example: "college.edu" or "mycampus.ac.in". Leave empty ("") if open to all verified students.
COLLEGE_EMAIL_DOMAIN="college.edu"

# Security & CORS
# In production, set to your Netlify domain (e.g. https://campusly.netlify.app)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://*.netlify.app"]
SECRET_KEY="replace-with-a-very-strong-random-secret-key-for-jwt"
ALGORITHM="HS256"

# Supabase Credentials
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-role-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# PostgreSQL Direct Connection String (Used by SQLAlchemy / Alembic)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"

# Supabase Storage Buckets
STORAGE_BUCKET_AVATARS="avatars"
STORAGE_BUCKET_POSTS="posts"
STORAGE_BUCKET_STORIES="stories"
STORAGE_BUCKET_COMMUNITIES="communities"
